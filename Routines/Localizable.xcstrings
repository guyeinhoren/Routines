        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מ-%1$@ עד %2$@, %3$lld רשומות"
          }
        }
      }
    },
    "Gentle Chime" : {
      "comment" : "Timer sound choice: a single soft chime",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "צלצול עדין"
          }
        }
      }
    },
    "Give a routine a duration, then start its timer from the routine's details. When the timer ends, it counts as one repetition for today." : {
      "comment" : "Welcome screen explanation of routine timers",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדירו לרוטינה משך זמן, ואז הפעילו את הטיימר שלה מתוך פרטי הרוטינה. כשהטיימר מסתיים, הוא נחשב כחזרה אחת עבור היום."
          }
        }
      }
    },
    "Green" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ירוק"
          }
        }
