    },
    "Each square is a day, and it fills as you record a routine. The chart button shows a month of squares in the list's colour — the deeper the colour, the more routines you completed. Tap a week to see its routines." : {
      "comment" : "Welcome screen explanation of how to read the squares",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ריבוע הוא יום, והוא מתמלא כשרושמים רוטינה. לחצן התרשים מציג חודש של ריבועים בצבע הרשימה — ככל שהצבע עמוק יותר, כך השלמתם יותר רוטינות. הקישו על שבוע כדי לראות את הרוטינות שלו."
          }
        }
      }
    },
    "Edit" : {
      "comment" : "Opens the editor from the detail view",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עריכה"
          }
        }
      }
    },
    "Existing Tags" : {
      "comment" : "VoiceOver label for the menu of tags already in use",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "תגים קיימים"
          }
        }
      }
    },
    "Finished Timer Counts as Done" : {
      "comment" : "Preference that records a repetition when a timer ends",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיום טיימר נחשב כביצוע"
          }
        }
      }
    },
    "Floor" : {
      "comment" : "Label for the lower bound of the value chart's y-axis.",
      "isCommentAutoGenerated" : true
    },
    "From %@ to %@, %lld entries" : {
      "comment" : "VoiceOver summary of the value chart: first value, latest value, number of entries",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From %1$@ to %2$@, %3$lld entries"
