{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld of %lld days complete this week" : {
      "comment" : "Accessibility value summarising the week",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הושלמו %1$lld מתוך %2$lld ימים השבוע"
          }
        }
      }
    },
    "%lld of %lld done today" : {
